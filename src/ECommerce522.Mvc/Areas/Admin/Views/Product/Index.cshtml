@model IEnumerable<Product>

@{
    const double discount = 50;
}

<!-- Filter Section -->
<section class="py-3 filter-bar">
    <div class="container">
        <div class="row" style="background-color: rgba(var(--bs-light-rgb), var(--bs-bg-opacity)) !important;">
            <div class="col-12">
                <form>
                    <div class="row">
                        <!-- Product Name -->
                        <div class="col-md-3">
                            <input type="text" class="form-control" placeholder="Product Name" name="ProductName" value="@ViewBag.ProductName">
                        </div>

                        <!-- Price Range -->
                        <div class="col-md-2">
                            <input type="number" class="form-control" placeholder="Min Price" name="minPrice" value="@ViewBag.MinPrice">
                        </div>
                        <div class="col-md-2">
                            <input type="number" class="form-control" placeholder="Max Price" name="maxPrice" value="@ViewBag.MaxPrice">
                        </div>

                        <!-- Category -->
                        <div class="col-md-2">
                            <select name="categoryId" class="form-control">
                                <option>--Select Category--</option>
                                @foreach (var item in ViewBag.Categories)
                                {
                                    @if (ViewBag.CategoryId == item.Id)
                                    {
                                        <option value="@item.Id" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Brand -->
                        <div class="col-md-2">
                            <select name="brandId" class="form-control">
                                <option>--Select Brand--</option>
                                @foreach (var item in ViewBag.Brands)
                                {
                                    @if (ViewBag.BrandId == item.Id)
                                    {
                                        <option value="@item.Id" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Low Quantity Product Checkbox -->
                        <div class="col-md-1">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" name="lessQuantity" value="true" @(ViewBag.LessQuantity is not null && ViewBag.LessQuantity ? "checked" : "")>
                                <label class="form-check-label">Low Quantity</label>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="col-md-2 my-2">
                            <button type="submit" class="btn btn-dark w-100">Filter</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<div class="container">
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h2 class="display-6">All Products</h2>
        </div>
        <div class="col-md-6 text-md-end text-start mt-2 mt-md-0">
            <a href="/Admin/Product/Create" class="btn btn-success">Create</a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">

            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Name</th>
                        <th scope="col">Price</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Status</th>
                        <th scope="col">Category Name</th>
                        <th scope="col">Brand Name</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <th scope="row">@item.Id</th>
                            <td>@item.Name</td>
                            <td>@item.Price.ToString("c")</td>
                            @if (item.Quantity > discount)
                            {
                                <td>@item.Quantity</td>
                            }
                            else
                            {
                                <td><span class="badge text-bg-danger">@item.Quantity</span></td>
                            }
                            @if (item.Status)
                            {
                                <td><span class="badge text-bg-success">Active</span></td>
                            }
                            else
                            {
                                <td><span class="badge text-bg-danger">In Active</span></td>
                            }
                            <td><span class="badge text-bg-primary">@item.Category.Name</span></td>
                            <td><span class="badge text-bg-primary">@item.Brand.Name</span></td>
                            <td>
                                @if (User.IsInRole(SD.SUPER_ADMIN_ROLE) || User.IsInRole(SD.ADMIN_ROLE))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" type="button" class="btn btn-warning">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-delete">Delete</a>
                                }
                                else
                                {
                                    <span>No Action!!</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-12 d-flex justify-content-center">
            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-center">
                    @if (ViewBag.currentPage > 1 && ViewBag.currentPage <= ViewBag.totalNumberOfPages)
                    {
                        <li class="page-item"><a class="page-link" href="/Admin/Product/Index?page=@(ViewBag.currentPage - 1)&productName=@ViewBag.ProductName&minPrice=@ViewBag.MinPrice&maxPrice=@ViewBag.MaxPrice&categoryId=@ViewBag.CategoryId&brandId=@ViewBag.BrandId&lessQuantity=@ViewBag.LessQuantity">Previous</a></li>
                    }

                    @for (var i = 1; i <= ViewBag.totalNumberOfPages; i++)
                    {
                        <li class="page-item"><a class="page-link" href="/Admin/Product/Index?page=@i&productName=@ViewBag.ProductName&minPrice=@ViewBag.MinPrice&maxPrice=@ViewBag.MaxPrice&categoryId=@ViewBag.CategoryId&brandId=@ViewBag.BrandId&lessQuantity=@ViewBag.LessQuantity">@i</a></li>
                    }

                    @if (ViewBag.currentPage < ViewBag.totalNumberOfPages)
                    {
                        <li class="page-item"><a class="page-link" href="/Admin/Product/Index?page=@(ViewBag.currentPage + 1)&productName=@ViewBag.ProductName&minPrice=@ViewBag.MinPrice&maxPrice=@ViewBag.MaxPrice&categoryId=@ViewBag.CategoryId&brandId=@ViewBag.BrandId&lessQuantity=@ViewBag.LessQuantity">Next</a></li>
                    }
                    
                </ul>
            </nav>
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteButtons = document.querySelectorAll(".btn-delete");

        deleteButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault(); // stop normal navigation

                const url = this.getAttribute("href");

                Swal.fire({
                    title: "Are you sure?",
                    text: "This action cannot be undone!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                          title: "Deleted!",
                          text: "Your file has been deleted.",
                          icon: "success"
                        });

                        // Redirect to delete URL
                        window.location.href = url;
                    }
                });
            });
        });
    });
</script>